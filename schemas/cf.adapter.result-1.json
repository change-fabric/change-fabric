{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.changefabric.org/schemas/cf.adapter.result-1.json",
  "title": "cf.adapter.result/1",
  "description": "What an execution adapter returns for one cf.adapter.request/1. effects lists outbound effect keys, never remote ids or bodies.",
  "type": "object",
  "required": ["schema", "op", "execution_id", "phase_id", "state"],
  "properties": {
    "schema": { "const": "cf.adapter.result/1" },
    "op": { "enum": ["prepare", "activate", "observe", "classify"] },
    "execution_id": { "type": "string", "minLength": 1 },
    "phase_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$" },
    "state": { "enum": ["prepared", "activated", "held", "indeterminate", "event", "idle"] },
    "reason": { "type": "string" },
    "effects": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
    "issue": {
      "type": "object",
      "properties": {
        "repo": { "type": "string" },
        "number": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "event": { "$ref": "#/$defs/event" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "state": { "const": "event" } } }, "then": { "required": ["event"] } },
    { "if": { "properties": { "state": { "enum": ["held", "indeterminate"] } } }, "then": { "required": ["reason"] } }
  ],
  "$defs": {
    "event": {
      "type": "object",
      "required": ["event_id", "source_id", "type"],
      "properties": {
        "event_id": { "type": "string", "minLength": 3 },
        "source_id": { "type": "string", "pattern": "^(comment|pr|run|tag|issue):\\S+$" },
        "type": {
          "enum": ["agent_started", "agent_failed", "asked", "pr_opened", "merged", "staging_passed", "release",
                   "unclassified", "stale_hold", "hold_due", "issue_closed"]
        },
        "ref": { "type": "string" },
        "created_at": { "type": "string" },
        "observed_at_seq": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
