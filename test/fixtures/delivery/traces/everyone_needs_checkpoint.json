{
  "name": "everyone_needs_checkpoint",
  "description": "Entering everyone needs the human checkpoint even on an auto rollout.",
  "policy": {
    "max_telemetry_age_s": 180,
    "min_baseline_requests": 50
  },
  "rollout": {
    "stages": [
      {
        "cohort": "internal",
        "dwell_minutes": 10,
        "min_requests": 5
      },
      {
        "cohort": "everyone"
      }
    ],
    "pacing": {
      "advance": "auto",
      "money_affecting": false
    },
    "guards": {
      "new_5xx_on_flagged_spans": {
        "max": 0
      },
      "new_exceptions_on_flagged_spans": {
        "max": 0
      },
      "p95_ms_vs_baseline": {
        "max_ratio": 1.25
      }
    }
  },
  "steps": [
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 0
    },
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 900
    },
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 960,
      "approval": true
    }
  ],
  "expect": [
    {
      "step": 0,
      "verdict": "pass",
      "action": "hold",
      "stage": "internal"
    },
    {
      "step": 1,
      "verdict": "pass",
      "action": "await_approval",
      "stage": "internal"
    },
    {
      "step": 2,
      "verdict": "pass",
      "action": "advance",
      "stage": "everyone"
    }
  ]
}
