{
  "name": "unknown_pauses_dwell",
  "description": "An unknown window pauses the dwell clock: 30 min pass, 40 min unknown, then 30 min pass is 60 min of dwell, not 100.",
  "policy": {
    "max_telemetry_age_s": 180,
    "min_baseline_requests": 50
  },
  "rollout": {
    "stages": [
      {
        "cohort": "internal",
        "dwell_minutes": 60,
        "min_requests": 20
      },
      {
        "cohort": "pilot",
        "dwell_minutes": 60,
        "min_requests": 50
      },
      {
        "cohort": "everyone"
      }
    ],
    "pacing": {
      "advance": "auto",
      "money_affecting": false
    },
    "guards": {
      "new_5xx_on_flagged_spans": {
        "max": 0
      },
      "new_exceptions_on_flagged_spans": {
        "max": 0
      },
      "p95_ms_vs_baseline": {
        "max_ratio": 1.25
      }
    }
  },
  "steps": [
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 0
    },
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 1800
    },
    {
      "requests": 0,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 4200
    },
    {
      "requests": 30,
      "new_5xx": 0,
      "new_exceptions": 0,
      "p95_ratio": 1.0,
      "baseline_requests": 500,
      "coverage": "complete",
      "telemetry_age_s": 10,
      "at_s": 6000
    }
  ],
  "expect": [
    {
      "step": 0,
      "verdict": "pass",
      "action": "hold",
      "stage": "internal"
    },
    {
      "step": 1,
      "verdict": "pass",
      "action": "hold",
      "stage": "internal"
    },
    {
      "step": 2,
      "verdict": "unknown",
      "action": "hold",
      "stage": "internal"
    },
    {
      "step": 3,
      "verdict": "pass",
      "action": "advance",
      "stage": "pilot"
    }
  ]
}
