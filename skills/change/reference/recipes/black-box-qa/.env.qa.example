# Copy to .env.qa (git-ignored), fill in, then before cf:change run:
#   set -a; . ./.env.qa; set +a
# Staging and prod use separate QA accounts so a leaked staging login never opens prod.
QA_STAGING_EMAIL=qa-staging@example.com
QA_STAGING_PASSWORD=change-me
QA_PROD_EMAIL=qa-prod@example.com
QA_PROD_PASSWORD=change-me
