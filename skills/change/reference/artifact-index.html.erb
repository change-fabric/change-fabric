<%#
  The team index: one page at the root of the team's artifact bucket listing
  every published cf:change run, across every contributor and every repo the
  team owns.

  Rendered by scripts/change_artifact_publish.rb from the run rows stored in
  the team's manifest table, and re-uploaded after each publish. The table is
  built client side from the JSON block below, which is the whole manifest: no
  backend, no API call, and the filter and sort work from a file the browser
  already has.
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>change-fabric runs: <%= h team_id %></title>
<style>
  :root {
    color-scheme: light dark;
    --bg: #ffffff; --fg: #16181d; --muted: #5c6370; --line: #e3e6ea; --card: #f7f8fa;
    --pass: #1f7a4d; --fail: #b3261e; --link: #1a4fd6;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #14161a; --fg: #e8eaee; --muted: #9aa2ad; --line: #2a2e35; --card: #1b1e24; --pass: #4cc38a; --fail: #ff6b60; --link: #7aa2ff; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; }
  main { max-width: 1200px; margin: 0 auto; padding: 32px 20px 80px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  a { color: var(--link); }
  .sub { color: var(--muted); margin: 0 0 20px; }
  .row { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin-bottom: 14px; }
  input, select { padding: 7px 9px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--fg); font: inherit; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--line); white-space: nowrap; }
  th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; cursor: pointer; user-select: none; }
  th[aria-sort="ascending"]::after { content: " up"; }
  th[aria-sort="descending"]::after { content: " down"; }
  td.detail { white-space: normal; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .badge { display: inline-block; padding: 2px 9px; border-radius: 999px; font-weight: 700; font-size: 12px; }
  .pass { background: color-mix(in srgb, var(--pass) 18%, transparent); color: var(--pass); }
  .fail { background: color-mix(in srgb, var(--fail) 18%, transparent); color: var(--fail); }
  .note { color: var(--muted); font-size: 13px; }
</style>
</head>
<body>
<main>
<h1>change-fabric runs</h1>
<p class="sub">Team <span class="mono"><%= h team_id %></span>. <%= rows.size %> published run(s), <%= failing %> failing, across <%= repos.size %> repo(s) and <%= contributors.size %> contributor(s). Index rebuilt <%= h generated_at %>.</p>

<div class="row">
  <input id="q" type="search" placeholder="Filter by repo, contributor, branch, PR" aria-label="Filter runs" size="34">
  <select id="contributor" aria-label="Contributor">
    <option value="">All contributors</option>
    <% contributors.each do |name| -%><option value="<%= h name %>"><%= h name %></option><% end -%>
  </select>
  <select id="repo" aria-label="Repo">
    <option value="">All repos</option>
    <% repos.each do |repo| -%><option value="<%= h repo %>"><%= h repo %></option><% end -%>
  </select>
  <select id="status" aria-label="Result">
    <option value="">Any result</option>
    <option value="pass">pass</option>
    <option value="fail">fail</option>
  </select>
  <span class="note" id="count"></span>
</div>

<div class="scroll">
<table id="runs">
  <thead><tr>
    <th data-key="generated_at">Date</th>
    <th data-key="contributor_name">Contributor</th>
    <th data-key="repo_id">Repo</th>
    <th data-key="project">Project</th>
    <th data-key="branch">Branch</th>
    <th data-key="pr_number">PR</th>
    <th data-key="status">Result</th>
    <th data-key="fail_count">Failing</th>
    <th>Artifact</th>
  </tr></thead>
  <tbody></tbody>
</table>
</div>
<noscript><p class="note">This index renders its table with JavaScript. The raw run list is in the manifest.json next to this page.</p></noscript>

<script type="application/json" id="runs-data"><%= json rows %></script>
<script>
  (function () {
    var data = JSON.parse(document.getElementById("runs-data").textContent);
    var body = document.querySelector("#runs tbody");
    var count = document.getElementById("count");
    var controls = {
      q: document.getElementById("q"),
      contributor: document.getElementById("contributor"),
      repo: document.getElementById("repo"),
      status: document.getElementById("status"),
    };
    var sort = { key: "generated_at", dir: -1 };

    function cell(text, className) {
      var td = document.createElement("td");
      td.textContent = text == null ? "" : String(text);
      if (className) td.className = className;
      return td;
    }

    function link(href, text) {
      var td = document.createElement("td");
      if (!href) { td.textContent = ""; return td; }
      var a = document.createElement("a");
      a.href = href;
      a.textContent = text;
      td.appendChild(a);
      return td;
    }

    function badge(status) {
      var td = document.createElement("td");
      var span = document.createElement("span");
      span.className = "badge " + (status === "fail" ? "fail" : "pass");
      span.textContent = String(status || "").toUpperCase();
      td.appendChild(span);
      return td;
    }

    function matches(row) {
      var text = controls.q.value.trim().toLowerCase();
      var haystack = [row.repo_id, row.project, row.contributor_name, row.branch, row.pr_number, row.run_id]
        .join(" ").toLowerCase();
      return (
        (!controls.contributor.value || row.contributor_name === controls.contributor.value) &&
        (!controls.repo.value || row.repo_id === controls.repo.value) &&
        (!controls.status.value || row.status === controls.status.value) &&
        (!text || haystack.indexOf(text) !== -1)
      );
    }

    function compare(a, b) {
      var x = a[sort.key], y = b[sort.key];
      if (x == null) x = "";
      if (y == null) y = "";
      if (typeof x === "number" && typeof y === "number") return (x - y) * sort.dir;
      return String(x).localeCompare(String(y)) * sort.dir;
    }

    function render() {
      var rows = data.filter(matches).sort(compare);
      body.textContent = "";
      rows.forEach(function (row) {
        var tr = document.createElement("tr");
        tr.appendChild(cell(row.generated_at));
        tr.appendChild(cell(row.contributor_name));
        tr.appendChild(cell(row.repo_id));
        tr.appendChild(cell(row.project));
        tr.appendChild(cell(row.branch));
        tr.appendChild(row.pr_url ? link(row.pr_url, "#" + row.pr_number) : cell(""));
        tr.appendChild(badge(row.status));
        tr.appendChild(cell(row.fail_count));
        tr.appendChild(link(row.url, "open"));
        body.appendChild(tr);
      });
      count.textContent = rows.length + " of " + data.length + " runs";
    }

    Object.keys(controls).forEach(function (name) {
      controls[name].addEventListener("input", render);
      controls[name].addEventListener("change", render);
    });

    Array.prototype.forEach.call(document.querySelectorAll("#runs th[data-key]"), function (th) {
      th.addEventListener("click", function () {
        var key = th.dataset.key;
        sort = { key: key, dir: sort.key === key ? -sort.dir : 1 };
        Array.prototype.forEach.call(document.querySelectorAll("#runs th"), function (other) {
          other.removeAttribute("aria-sort");
        });
        th.setAttribute("aria-sort", sort.dir === 1 ? "ascending" : "descending");
        render();
      });
    });

    render();
  })();
</script>
</main>
</body>
</html>
