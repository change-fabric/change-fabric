    return wrap;
  }
  function table(headers, rows, numeric) {
    var t = el("table");
    var thead = el("thead");
    var tr = el("tr");
    headers.forEach(function (h, i) {
      var th = el("th", numeric && numeric[i] ? "num" : null, h);
      th.setAttribute("scope", "col");
      tr.appendChild(th);
    });
    thead.appendChild(tr);
    t.appendChild(thead);
    var tbody = el("tbody");
    rows.forEach(function (cells) {
      var row = el("tr");
      cells.forEach(function (c, i) {
        var td = el("td", numeric && numeric[i] ? "num" : null);
        if (c instanceof Node) td.appendChild(c); else td.textContent = c === null || c === undefined ? "" : String(c);
        row.appendChild(td);
      });
      tbody.appendChild(row);
    });
    t.appendChild(tbody);
    return t;
  }
  function empty(host, text) { clear(host); host.appendChild(el("p", "empty", text)); }

  // --- filters
  function fillSelect(id, key, values, extra) {
    var select = byId(id);
    clear(select);
    var opts = [["", "All"]].concat(extra || []).concat(values.map(function (v) { return [v, v]; }));
    opts.forEach(function (o) {
      var option = el("option", null, o[1]);
      option.value = o[0];
      select.appendChild(option);
