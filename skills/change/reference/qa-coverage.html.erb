  }

  function caseId(item) { return typeof item.id === "string" ? item.id : ""; }

  // Latest toolkit run's cases, each with its last ten results across the
  // filtered runs, oldest first.
  function casesTable(runs, f) {
    var carriers = runs.filter(function (r) { return matches(r, f, ALL_KEYS) && isObj(r.cases) && Array.isArray(r.cases.items); });
    var latest = carriers[carriers.length - 1];
    if (!latest) return null;
    var recent = carriers.slice(-10);
    var rows = latest.cases.items.filter(isObj).map(function (item) {
      var id = caseId(item);
      var history = recent.map(function (r) {
        var hit = r.cases.items.filter(function (c) { return isObj(c) && caseId(c) === id; })[0];
        return hit ? String(hit.status) : null;
