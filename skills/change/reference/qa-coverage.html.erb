      var pa = a.line && a.line.pct !== null ? a.line.pct : Infinity;
      var pb = b.line && b.line.pct !== null ? b.line.pct : Infinity;
      if (pa !== pb) return pa - pb;
      return a.name < b.name ? -1 : a.name > b.name ? 1 : 0;
    });
    return { runId: latest.id, sha: shortSha(latest), rows: rows };
  }

  function safePrUrl(pr) {
    return isObj(pr) && typeof pr.url === "string" && /^https:\/\//.test(pr.url) ? pr.url : null;
  }

  // Newest first; records this page cannot read are listed with the reason.
  function history(normalized) {
    var rows = normalized.runs.slice().reverse().map(function (r) {
      var pr = isObj(r.git) && isObj(r.git.pr) ? r.git.pr : null;
      return {
        id: r.id, recorded_at: r.recorded_at, schema: r.schema, toolkit: r.toolkit == null ? "" : String(r.toolkit),
        source: r.source == null ? "" : String(r.source), scope: r.scope == null ? "" : String(r.scope),
        app: appOf(r) || "", profile: r.profile == null ? "" : String(r.profile), branch: branchOf(r) || "", sha: shortSha(r) || "",
        pr: pr && typeof pr.number === "number" ? { number: pr.number, url: safePrUrl(pr) } : null, note: ""
      };
    });
    normalized.excluded.forEach(function (x) {
