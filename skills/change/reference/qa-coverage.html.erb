      var exercised = list(i.cases_static).length > 0 || list(i.cases_reached).length > 0 ||
        cells.some(function (c) { return c.status === "pass" || c.status === "warn" || c.status === "fail"; });
      return { path: String(i.path), exercised: exercised, cells: cells };
    });
    rows.sort(function (a, b) {
      if (a.exercised !== b.exercised) return a.exercised ? 1 : -1;
      return a.path < b.path ? -1 : a.path > b.path ? 1 : 0;
    });
    var undeclared = items.filter(function (i) { return i.declared !== true; }).map(function (i) { return String(i.path); });
