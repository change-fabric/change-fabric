        status: String(item.status), attempts: typeof item.attempts === "number" ? item.attempts : null,
        flaky: item.flaky === true, source: typeof item.source === "string" ? item.source : "",
        quarantine: q ? { reason: q.reason == null ? "" : String(q.reason), until: q.until == null ? "" : String(q.until), expired: q.expired === true } : null,
        history: history.join(" ")
