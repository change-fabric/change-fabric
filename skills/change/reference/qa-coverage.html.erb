      return matches(r, f, IMPORT_KEYS) && isObj(r.imports) && list(r.imports.coverage).length > 0;
    });
    var latest = carriers[carriers.length - 1];
    if (!latest) return null;
    var earlier = carriers.slice(0, -1).reverse();
    var rows = [];
    list(latest.imports.coverage).filter(isObj).forEach(function (entry) {
      var prevRun = earlier.filter(function (r) {
        return list(r.imports.coverage).some(function (c) { return isObj(c) && c.label === entry.label; });
      })[0];
      var prevGroups = {};
      if (prevRun) {
        var prevEntry = list(prevRun.imports.coverage).filter(function (c) { return isObj(c) && c.label === entry.label; })[0];
        list(prevEntry.groups).filter(isObj).forEach(function (g) { prevGroups[g.name] = g; });
      }
      list(entry.groups).filter(isObj).forEach(function (g) {
        var line = isObj(g.line) ? ratio(num(g.line.covered), num(g.line.total)) : null;
        var branch = isObj(g.branch) ? ratio(num(g.branch.covered), num(g.branch.total)) : null;
        var prev = prevGroups[g.name];
