          label: String(entry.label), format: String(entry.format), name: String(g.name),
          line: line, branch: branch, delta: delta(line, prevLine), prevSha: prevRun ? shortSha(prevRun) : null,
          stale: entry.stale === true, truncated: entry.groups_truncated === true
