  });

  // --- route x lane matrix
  function renderRoutes() {
    var run = M.latestToolkit(runs, filters);
    var m = M.routeMatrix(run);
    var host = byId("routes-table");
    byId("routes-run").textContent = m ? "Run " + m.runId + (m.sha ? " at " + m.sha : "") : "";
    byId("routes-undeclared").textContent = m && m.undeclared.length ? "Exercised but not declared: " + m.undeclared.join(", ") : "";
    if (!m) { empty(host, "Routes not reported for these filters."); return; }
    if (m.rows.length === 0) { empty(host, "No declared routes in this run."); return; }
    var rows = m.rows.map(function (r) {
      return [r.path + (r.exercised ? "" : " (not exercised)")].concat(r.cells.map(function (c) { return statusCell(c.status, c.label); }));
    });
    clear(host);
    host.appendChild(table(["Route"].concat(m.lanes), rows));
  }

  // --- cases
  function renderCases() {
    var c = M.casesTable(runs, filters);
    var host = byId("cases-table");
