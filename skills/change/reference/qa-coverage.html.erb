    });
    renderTrendTable(tr);
    if (tr.points.length === 0 || live.length === 0) { empty(host, "No runs match these filters."); return; }

    var n = tr.points.length;
    var plotW = W - PAD.left - PAD.right, plotH = H - PAD.top - PAD.bottom;
    function x(i) { return PAD.left + (n === 1 ? plotW / 2 : (i * plotW) / (n - 1)); }
    function y(v) { return PAD.top + plotH - (v / 100) * plotH; }

    var summary = live.map(function (s) {
      var last = s.values.filter(function (v) { return v !== null; }).pop();
      return s.label + " " + last.toFixed(1) + "%";
    }).join(", ");
    var chart = svg("svg", { viewBox: "0 0 " + W + " " + H, class: "chart", role: "img",
      "aria-label": "Trend over " + n + " run(s), latest: " + summary + ". A table view follows." });

    [0, 25, 50, 75, 100].forEach(function (v) {
      chart.appendChild(svg("line", { x1: PAD.left, x2: W - PAD.right, y1: y(v), y2: y(v), class: "grid-line" }));
      var t = svg("text", { x: PAD.left - 6, y: y(v) + 4, "text-anchor": "end" });
      t.textContent = v + "%";
      chart.appendChild(t);
    });
    var every = Math.max(1, Math.ceil(n / 7));
    var lastTick = (n - 1) - ((n - 1) % every);
    tr.points.forEach(function (p, i) {
      var tick = i % every === 0 || (i === n - 1 && i - lastTick >= every * 0.6);
      if (!tick) return;
      var t = svg("text", { x: x(i), y: H - 8, "text-anchor": "middle" });
      t.textContent = p.date;
      chart.appendChild(t);
    });

    var ends = [];
    // A run that did not measure a series is skipped, not a break: the line
    // joins the runs that did.
    live.forEach(function (s) {
      var d = "", lastI = -1, count = 0;
      s.values.forEach(function (v, i) {
        if (v === null) return;
        d += (count === 0 ? "M " : " L ") + x(i).toFixed(1) + " " + y(v).toFixed(1);
        count += 1;
        lastI = i;
      });
      chart.appendChild(svg("path", { d: d, class: "series s" + s.slot }));
      chart.appendChild(svg("circle", { cx: x(lastI), cy: y(s.values[lastI]), r: 4, class: "dot f" + s.slot }));
      ends.push({ label: s.label + " " + s.values[lastI].toFixed(1) + "%", x: x(lastI), y: y(s.values[lastI]) });
    });
    ends.sort(function (a, b) { return a.y - b.y; });
    for (var k = 1; k < ends.length; k++) if (ends[k].y - ends[k - 1].y < 14) ends[k].y = ends[k - 1].y + 14;
    ends.forEach(function (e) {
      var t = svg("text", { x: W - PAD.right + 8, y: e.y + 4, class: "end-label" });
      t.textContent = e.label;
      chart.appendChild(t);
    });

    var cursor = svg("line", { x1: 0, x2: 0, y1: PAD.top, y2: PAD.top + plotH, class: "hover-line", visibility: "hidden" });
    chart.appendChild(cursor);
    var tip = el("div", "tooltip hidden");
    tip.setAttribute("role", "presentation");
    var colW = n === 1 ? plotW : plotW / (n - 1);
    tr.points.forEach(function (p, i) {
      var col = svg("rect", { x: x(i) - colW / 2, y: PAD.top, width: colW, height: plotH, class: "hover-col" });
      function enter() {
        cursor.setAttribute("x1", x(i));
        cursor.setAttribute("x2", x(i));
        cursor.setAttribute("visibility", "visible");
        clear(tip);
        tip.appendChild(el("p", "tip-head", p.date + (p.sha ? " " + p.sha : "")));
        if (p.pr && typeof p.pr.number === "number") tip.appendChild(el("p", null, "PR #" + p.pr.number));
        if (p.app) tip.appendChild(el("p", null, "App " + p.app));
        if (p.profile) tip.appendChild(el("p", null, "Profile " + p.profile));
        if (p.branch) tip.appendChild(el("p", null, "Branch " + p.branch));
        tr.series.forEach(function (s) {
          if (s.values[i] !== null) tip.appendChild(el("p", null, s.label + ": " + s.values[i].toFixed(1) + "%"));
        });
