  }
  var opts = M.options(runs);
  fillSelect("f-app", "app", opts.apps);
  show(byId("f-app-label"), opts.apps.length > 0);
  fillSelect("f-profile", "profile", opts.profiles);
  fillSelect("f-branch", "branch", opts.branches, opts.hasTrunk ? [[M.TRUNK, "Trunk"]] : []);
  fillSelect("f-scope", "scope", opts.scopes);
  fillSelect("f-source", "source", opts.sources);

  // --- headline tiles
  var TILE_LABELS = {
    routes: "Routes exercised", cases: "Cases passing", lanes: "Lanes passing", findings: "Open failing findings",
    line: "Line coverage", branch: "Branch coverage", tests: "Imported tests passing"
  };
  function renderTile(host, t) {
    var card = el("div", "tile");
    card.appendChild(el("p", "tile-label", TILE_LABELS[t.family]));
    var v = t.value;
    if (!v) {
