    clear(toolkit);
    clear(imported);
    ["routes", "cases", "lanes", "findings"].forEach(function (f) { renderTile(toolkit, hl[f]); });
    ["line", "branch", "tests"].forEach(function (f) { renderTile(imported, hl[f]); });
  }

  // --- trend chart
  var W = 760, H = 260, PAD = { top: 12, right: 170, bottom: 28, left: 40 };
  function renderTrend() {
    var tr = M.trend(runs, filters);
    var host = byId("trend-chart");
    var legend = byId("trend-legend");
    clear(host);
    clear(legend);
    var live = tr.series.filter(function (s) { return s.values.some(function (v) { return v !== null; }); });
    tr.series.forEach(function (s) {
      var li = el("li");
      var key = el("span", "key s" + s.slot);
