  }

  root.CFCoverageModel = {
    TRUNK: TRUNK, SERIES: SERIES, LANES: LANES, RUN_SCHEMA_MAX: RUN_SCHEMA_MAX,
    floorPct: floorPct, normalize: normalize, matches: matches, options: options,
