<%#
  The QA coverage page: index.html beside a coverage store's report-data.js.

  Rendered by scripts/change_coverage_page.rb from the resolved brand alone
  (ChangeCoverageBrand::Resolved) and fixed constants. It carries no run data,
  no timestamp and no path: the runs arrive at view time through a classic
  <script src="report-data.js">, which works from file:// where a JSON fetch
  cannot. Every color is a hex literal baked here by Ruby; the scripts never
  compute a color.

  Safety rules the tests enforce: no module scripts, no network calls, no
  absolute URL literal anywhere, and every piece of run data reaches the DOM
  through textContent or setAttribute, never as markup. Imported test names
  and messages are untrusted text.
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h title %></title>
<style>
  :root {
    color-scheme: light;
<%= css_tokens('light', '    ') %>
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
<%= css_tokens('dark', '      ') %>
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
<%= css_tokens('dark', '    ') %>
  }
  @media print {
    :root:not([data-theme="print"]), :root[data-theme] {
      color-scheme: light;
<%= css_tokens('light', '      ') %>
    }
    .theme-toggle, .filters, .view-toggle { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { transition: none !important; animation: none !important; scroll-behavior: auto !important; }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body { margin: 0; background: var(--ground); color: var(--ink); font: 15px/1.55 <%= font_stack %>; }
  :focus-visible { outline: 2px solid var(--focus); outline-offset: 2px; }
  a { color: var(--accent-text); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 13px; }
  .note { color: var(--muted); font-size: 13px; margin: 6px 0; }
  .masthead { border-bottom: 4px solid var(--accent); background: var(--ground); }
  .masthead-inner { max-width: 1120px; margin: 0 auto; padding: 16px; display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .logo { height: 40px; width: auto; max-width: 180px; object-fit: contain; display: block; }
  .logo-dark { display: none; }
  :root[data-theme="dark"] .has-dark-logo .logo-light { display: none; }
  :root[data-theme="dark"] .has-dark-logo .logo-dark { display: block; }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .has-dark-logo .logo-light { display: none; }
    :root:not([data-theme="light"]) .has-dark-logo .logo-dark { display: block; }
  }
  .brand-name { margin: 0; font-size: 22px; line-height: 1.2; }
  .brand-sub { margin: 0; color: var(--muted); font-size: 14px; }
  .brand-text { flex: 1 1 200px; min-width: 0; }
  button { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--border); border-radius: 8px; padding: 6px 12px; cursor: pointer; }
  button:hover { border-color: var(--accent-text); }
  main { max-width: 1120px; margin: 0 auto; padding: 8px 16px 64px; }
  h2 { font-size: 18px; margin: 36px 0 10px; padding-bottom: 6px; border-bottom: 1px solid var(--border); }
  h3 { font-size: 13px; margin: 18px 0 8px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
  .filters { display: flex; flex-wrap: wrap; gap: 12px; align-items: end; margin-top: 20px; }
  .filters label { display: flex; flex-direction: column; font-size: 12px; color: var(--muted); gap: 3px; }
  .filters select { font: inherit; font-size: 14px; color: var(--ink); background: var(--ground); border: 1px solid var(--border); border-radius: 8px; padding: 6px 8px; min-width: 130px; }
  .banner { background: var(--surface); border: 1px solid var(--border); border-left: 4px solid var(--accent); border-radius: 8px; padding: 10px 12px; margin: 14px 0 0; }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .tile { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; }
  .tile-label { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; margin: 0; }
  .tile-value { font-size: 28px; font-weight: 600; margin: 2px 0; font-variant-numeric: tabular-nums; }
  .tile-value.missing { font-size: 16px; font-weight: 400; color: var(--muted); }
  .tile-detail, .tile-delta { margin: 0; font-size: 13px; color: var(--muted); }
  .panel { background: var(--chart-surface); color: var(--chart-ink); border: 1px solid var(--border); border-radius: 10px; padding: 12px; }
  .panel .note { color: var(--chart-muted); }
  .chart-wrap { position: relative; overflow-x: auto; }
  .chart { display: block; width: 100%; min-width: 560px; height: auto; }
  .chart text { fill: var(--chart-muted); font-size: 11px; }
  .chart .end-label { fill: var(--chart-ink); font-size: 12px; }
  .grid-line { stroke: var(--chart-grid); stroke-width: 1; }
  .series { fill: none; stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .dot { stroke: var(--chart-surface); stroke-width: 2; }
  .hover-col { fill: transparent; }
  .hover-line { stroke: var(--chart-muted); stroke-width: 1; }
  .s1 { stroke: var(--s1); } .s2 { stroke: var(--s2); } .s3 { stroke: var(--s3); } .s4 { stroke: var(--s4); }
  .f1 { fill: var(--s1); } .f2 { fill: var(--s2); } .f3 { fill: var(--s3); } .f4 { fill: var(--s4); }
  .legend { display: flex; flex-wrap: wrap; gap: 6px 16px; list-style: none; padding: 0; margin: 0 0 8px; font-size: 13px; }
  .legend li { display: flex; align-items: center; gap: 6px; }
  .key { display: inline-block; width: 16px; height: 0; border-top: 2px solid; border-radius: 1px; }
  .key.s1 { border-color: var(--s1); } .key.s2 { border-color: var(--s2); } .key.s3 { border-color: var(--s3); } .key.s4 { border-color: var(--s4); }
  .tooltip { position: absolute; pointer-events: none; background: var(--chart-surface); color: var(--chart-ink); border: 1px solid var(--chart-grid); border-radius: 8px; padding: 8px 10px; font-size: 12px; box-shadow: 0 2px 8px rgba(0, 0, 0, .12); min-width: 160px; z-index: 2; }
  .tooltip p { margin: 0; }
  .tooltip .tip-head { font-weight: 600; margin-bottom: 4px; }
  .scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 14px; }
  th, td { text-align: left; padding: 7px 9px; border-bottom: 1px solid var(--border); vertical-align: top; }
  th { color: var(--muted); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; font-weight: 600; }
  td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
  .status { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
  .mark { display: inline-block; width: 10px; height: 10px; border-radius: 50%; border: 2px solid var(--muted); background: transparent; flex: none; }
  .mark.st-pass { background: var(--pass); border-color: var(--pass); }
  .mark.st-warn { background: var(--warn); border-color: var(--warn); border-radius: 2px; }
  .mark.st-fail { background: var(--fail); border-color: var(--fail); border-radius: 0; }
  .mark.st-off { border-style: dashed; }
  .bar-track { position: relative; height: 10px; min-width: 90px; background: var(--surface); border: 1px solid var(--border); border-radius: 2px; }
  .bar-fill { position: absolute; left: 0; top: 0; bottom: 0; background: var(--accent); border-radius: 0 4px 4px 0; }
  .flag { color: var(--warn); font-weight: 600; }
  .empty { color: var(--muted); font-style: italic; }
  footer { max-width: 1120px; margin: 0 auto; padding: 16px 16px 40px; color: var(--muted); font-size: 13px; border-top: 1px solid var(--border); }
  footer p { margin: 2px 0; }
  .hidden { display: none; }
  .ns-source { position: absolute; width: 0; height: 0; overflow: hidden; }
</style>
</head>
<body>
<header class="masthead">
  <div class="masthead-inner<%= logo_dark_uri ? ' has-dark-logo' : '' %>">
<% if logo_uri -%>
    <img class="logo logo-light" src="<%= h logo_uri %>" alt="<%= h name %> logo">
<% end -%>
<% if logo_dark_uri -%>
    <img class="logo logo-dark" src="<%= h logo_dark_uri %>" alt="<%= h name %> logo">
<% end -%>
    <div class="brand-text">
      <p class="brand-name"><%= h name %></p>
      <h1 class="brand-sub">QA coverage</h1>
    </div>
    <button type="button" class="theme-toggle" id="theme-toggle">Theme: auto</button>
  </div>
</header>
<main>
  <p class="banner hidden" id="load-status" role="status"></p>

  <section aria-labelledby="filters-title">
    <h2 id="filters-title" class="hidden">Filters</h2>
    <div class="filters" id="filters">
      <label id="f-app-label">App<select id="f-app"></select></label>
      <label>Profile<select id="f-profile"></select></label>
      <label>Branch<select id="f-branch"></select></label>
      <label>Scope<select id="f-scope"></select></label>
      <label>Source<select id="f-source"></select></label>
    </div>
    <p class="banner hidden" id="default-note"></p>
  </section>

  <section aria-labelledby="headline-title">
    <h2 id="headline-title">Headline</h2>
    <h3>Measured by Change Fabric</h3>
    <div class="tiles" id="tiles-toolkit"></div>
    <h3>Imported</h3>
    <div class="tiles" id="tiles-imported"></div>
  </section>

  <section aria-labelledby="trend-title">
    <h2 id="trend-title">Trend</h2>
    <div class="panel">
      <ul class="legend" id="trend-legend"></ul>
      <div class="chart-wrap" id="trend-chart"></div>
      <p class="note" id="trend-note">Each point is one run, in recorded order; the axis is 0 to 100%.</p>
      <button type="button" class="view-toggle" id="trend-toggle" aria-expanded="false" aria-controls="trend-table-wrap">View as table</button>
      <div class="scroll hidden" id="trend-table-wrap"></div>
    </div>
  </section>

  <section aria-labelledby="routes-title">
    <h2 id="routes-title">Routes by lane</h2>
    <p class="note">Routes are matched literally; /claims/123 and /claims/:id are different routes.</p>
    <p class="note" id="routes-run"></p>
    <div class="scroll" id="routes-table"></div>
    <p class="note" id="routes-undeclared"></p>
  </section>

  <section aria-labelledby="cases-title">
    <h2 id="cases-title">Test cases</h2>
    <p class="note" id="cases-run"></p>
    <div class="scroll" id="cases-table"></div>
  </section>

  <section aria-labelledby="groups-title">
    <h2 id="groups-title">Imported coverage by group</h2>
    <p class="note" id="groups-run"></p>
    <div class="scroll" id="groups-table"></div>
  </section>

  <section aria-labelledby="history-title">
    <h2 id="history-title">Run history</h2>
    <div class="scroll" id="history-table"></div>
  </section>
</main>
<footer>
  <p>Generated by Change Fabric</p>
  <p>Page template version <%= template_version %>; understands run schema 1 to <%= run_schema_max %>.</p>
</footer>
<svg class="ns-source" aria-hidden="true" focusable="false" width="0" height="0"></svg>
<script src="report-data.js"></script>
<script id="cf-coverage-model">
(function (root) {
  "use strict";

  var RUN_SCHEMA_MAX = <%= run_schema_max %>;
  var LANES = <%= lanes_json %>;
  var TRUNK = "@trunk";
  var CASE_STATUSES = ["pass", "fail", "error", "skip", "warn"];
  var TEST_STATUSES = ["pass", "fail", "error", "skip"];

  // One adapter per run schema this page understands. A newer schema is
  // excluded and listed rather than read as if it were this one.
  var ADAPTERS = { 1: function (run) { return run; } };

  var SERIES = [
    { key: "routes", label: "Route coverage", slot: 1 },
    { key: "cases", label: "Case pass rate", slot: 2 },
    { key: "line", label: "Line coverage", slot: 3 },
    { key: "branch", label: "Branch coverage", slot: 4 }
  ];

  var CELL_LABELS = {
    pass: "pass", warn: "warn", fail: "fail", no_result: "not exercised",
    not_declared: "not declared", lane_off: "lane off", n_a: "n/a"
  };

  function isObj(v) { return v !== null && typeof v === "object" && !Array.isArray(v); }
  function num(v) { return typeof v === "number" && isFinite(v) ? v : 0; }
  function list(v) { return Array.isArray(v) ? v : []; }

  // Mirrors ColorCheck#shown_ratio: floored, never rounded up past a mark.
  function floorPct(covered, total) {
    if (typeof covered !== "number" || typeof total !== "number" || !(total > 0)) return null;
    return Math.floor(covered * 1000 / total) / 10;
  }

  function compareRuns(a, b) {
    if (a.recorded_at < b.recorded_at) return -1;
    if (a.recorded_at > b.recorded_at) return 1;
    if (a.id < b.id) return -1;
    if (a.id > b.id) return 1;
    return 0;
  }

  // Dedupe by id (the last copy wins, as the store merges), sort, adapt, and
  // set aside every record this page cannot read.
  function normalize(data) {
    var raw = isObj(data) ? list(data.runs) : [];
    var byId = new Map();
    var excluded = [];
    raw.forEach(function (run) {
      if (!isObj(run) || typeof run.id !== "string" || run.id === "") {
        excluded.push({ id: null, schema: null, recorded_at: null, kind: "invalid", reason: "invalid record" });
        return;
      }
      byId.set(run.id, run);
    });
    var runs = [];
    byId.forEach(function (run) {
      var schema = run.schema;
      if (typeof schema !== "number" || Math.floor(schema) !== schema || schema < 1 || typeof run.recorded_at !== "string") {
        excluded.push({ id: run.id, schema: typeof schema === "number" ? schema : null, recorded_at: typeof run.recorded_at === "string" ? run.recorded_at : null, kind: "invalid", reason: "invalid record" });
      } else if (schema > RUN_SCHEMA_MAX || !ADAPTERS[schema]) {
        excluded.push({ id: run.id, schema: schema, recorded_at: run.recorded_at, kind: "newer", reason: "written by a newer toolkit (schema " + schema + ")" });
      } else {
        runs.push(ADAPTERS[schema](run));
      }
    });
    runs.sort(compareRuns);
    return { meta: isObj(data) && isObj(data.meta) ? data.meta : null, runs: runs, excluded: excluded };
  }

  function branchOf(run) { return isObj(run.git) && typeof run.git.branch === "string" ? run.git.branch : null; }
  function onTrunk(run) { return isObj(run.git) && run.git.trunk === true; }

  function appOf(run) { return typeof run.app === "string" && run.app !== "" ? run.app : null; }

  // "app?" is the app filter for the imported family: a repo-wide import run
  // (no app) counts under every app, since one CI import covers the repo.
  function matches(run, f, keys) {
    return keys.every(function (key) {
      var field = key === "app?" ? "app" : key;
      var want = f[field] || "";
      if (want === "") return true;
      if (key === "branch") return want === TRUNK ? onTrunk(run) : branchOf(run) === want;
      if (key === "app?") return appOf(run) === null || appOf(run) === want;
      return run[key] === want;
    });
  }
  var ALL_KEYS = ["app", "profile", "branch", "scope", "source"];
  var IMPORT_KEYS = ["app?", "profile", "branch"];

  function options(runs) {
    function uniq(fn) {
      var seen = {};
      runs.forEach(function (r) { var v = fn(r); if (typeof v === "string" && v !== "") seen[v] = true; });
      return Object.keys(seen).sort();
    }
    return {
      apps: uniq(appOf),
      profiles: uniq(function (r) { return r.profile; }),
      branches: uniq(branchOf),
      scopes: uniq(function (r) { return r.scope; }),
      sources: uniq(function (r) { return r.source; }),
      hasTrunk: runs.some(onTrunk)
    };
  }

  // Full-scope trunk runs by default; failing that, the latest full-scope run
  // on any branch, named so the reader knows it is not trunk. A store holding
  // more than one app shows one app at a time (the app of that latest run),
  // so no number or delta ever mixes two apps.
  function defaultFilters(runs) {
    var base = { app: "", profile: "", branch: "", scope: "", source: "" };
    var all = runs.filter(function (r) { return r.scope === "all"; });
    var apps = options(runs).apps;
    function pickApp(pool) {
      if (apps.length < 2) return "";
      var withApp = pool.filter(function (r) { return appOf(r) !== null; });
      return withApp.length > 0 ? appOf(withApp[withApp.length - 1]) : apps[0];
    }
    var trunkAll = all.filter(onTrunk);
    if (trunkAll.length > 0) {
      return { filters: Object.assign(base, { app: pickApp(trunkAll), branch: TRUNK, scope: "all" }), fallbackBranch: null };
    }
    if (all.length > 0) {
      var latest = all[all.length - 1];
      return {
        filters: Object.assign(base, { app: pickApp([latest]), branch: branchOf(latest) || "", scope: "all" }),
        fallbackBranch: branchOf(latest) || "(unknown)"
      };
    }
    return { filters: Object.assign(base, { app: pickApp(runs) }), fallbackBranch: null };
  }

  // --- metric families: each returns null when the run did not measure it.
  function ratio(covered, total, extra) {
    var out = { covered: covered, total: total, pct: floorPct(covered, total) };
    return extra ? Object.assign(out, extra) : out;
  }

  var METRICS = {
    routes: function (run) {
      var r = run.routes;
      if (!isObj(r) || typeof r.declared_total !== "number") return null;
      return ratio(num(r.declared_exercised), r.declared_total);
    },
    cases: function (run) {
      var c = run.cases;
      if (!isObj(c) || !isObj(c.counts)) return null;
      var total = CASE_STATUSES.reduce(function (s, k) { return s + num(c.counts[k]); }, 0);
      return ratio(num(c.counts.pass), total, { flaky: num(c.counts.flaky), quarantined: num(c.counts.quarantined) });
    },
    lanes: function (run) {
      var l = run.lanes;
      if (!isObj(l) || !isObj(l.results)) return null;
      var ran = list(l.ran);
      var passing = ran.filter(function (lane) { return isObj(l.results[lane]) && l.results[lane].status === "pass"; }).length;
      return ratio(passing, ran.length);
    },
    findings: function (run) {
      if (!isObj(run.findings) || typeof run.findings.fail !== "number") return null;
      return { count: run.findings.fail };
    },
    line: function (run) { return sumCoverage(run, "line"); },
    branch: function (run) { return sumCoverage(run, "branch"); },
    tests: function (run) {
      var entries = isObj(run.imports) ? list(run.imports.test_results).filter(function (t) { return isObj(t) && isObj(t.counts); }) : [];
      if (entries.length === 0) return null;
      var pass = 0, total = 0, flaky = 0;
      entries.forEach(function (t) {
        pass += num(t.counts.pass);
        total += TEST_STATUSES.reduce(function (s, k) { return s + num(t.counts[k]); }, 0);
        flaky += num(t.counts.flaky);
      });
      return ratio(pass, total, { flaky: flaky });
    }
  };

  function sumCoverage(run, kind) {
    var entries = isObj(run.imports) ? list(run.imports.coverage).filter(function (c) { return isObj(c) && isObj(c[kind]); }) : [];
    if (entries.length === 0) return null;
    var covered = 0, total = 0;
    entries.forEach(function (c) { covered += num(c[kind].covered); total += num(c[kind].total); });
    return ratio(covered, total);
  }

  var TOOLKIT = ["routes", "cases", "lanes", "findings"];
  var IMPORTED = ["line", "branch", "tests"];

  function delta(cur, prev) {
    if (!cur || !prev) return null;
    if (typeof cur.count === "number" && typeof prev.count === "number") return cur.count - prev.count;
    if (typeof cur.pct === "number" && typeof prev.pct === "number") return Math.round((cur.pct - prev.pct) * 10) / 10;
    return null;
  }

  function shortSha(run) { return run && isObj(run.git) && typeof run.git.short_sha === "string" ? run.git.short_sha : null; }

  // The toolkit family follows every filter; the imported family follows only
  // branch and profile, so a CI import run (scope "import") still counts.
  function candidates(runs, f, family) {
    return runs.filter(function (r) { return matches(r, f, TOOLKIT.indexOf(family) >= 0 ? ALL_KEYS : IMPORT_KEYS); });
  }

  function tile(runs, f, family) {
    var carriers = candidates(runs, f, family).filter(function (r) { return METRICS[family](r) !== null; });
    var cur = carriers[carriers.length - 1] || null;
    var prev = carriers[carriers.length - 2] || null;
    var value = cur ? METRICS[family](cur) : null;
    var prevValue = prev ? METRICS[family](prev) : null;
    return {
      family: family, value: value, runId: cur ? cur.id : null, sha: shortSha(cur),
      branch: cur ? branchOf(cur) : null, delta: delta(value, prevValue), prevSha: shortSha(prev)
    };
  }

  function headline(runs, f) {
    var out = {};
    TOOLKIT.concat(IMPORTED).forEach(function (family) { out[family] = tile(runs, f, family); });
    return out;
  }

  // One x position per run that carries any plotted family under the
  // filters; a series with no value at a run leaves a gap.
  function trend(runs, f) {
    var points = runs.filter(function (r) {
      return SERIES.some(function (s) { return matches(r, f, TOOLKIT.indexOf(s.key) >= 0 ? ALL_KEYS : IMPORT_KEYS) && METRICS[s.key](r) !== null; });
    });
    return {
      points: points.map(function (r) {
        return {
          id: r.id, date: typeof r.recorded_at === "string" ? r.recorded_at.slice(0, 10) : "",
          sha: shortSha(r), pr: isObj(r.git) && isObj(r.git.pr) ? r.git.pr : null,
          app: appOf(r), profile: typeof r.profile === "string" ? r.profile : null, branch: branchOf(r)
        };
      }),
      series: SERIES.map(function (s) {
        var keys = TOOLKIT.indexOf(s.key) >= 0 ? ALL_KEYS : IMPORT_KEYS;
        return {
          key: s.key, label: s.label, slot: s.slot,
          values: points.map(function (r) {
            if (!matches(r, f, keys)) return null;
            var v = METRICS[s.key](r);
            return v ? v.pct : null;
          })
        };
      })
    };
  }

  function latestToolkit(runs, f) {
    var list_ = runs.filter(function (r) { return matches(r, f, ALL_KEYS) && (isObj(r.routes) || isObj(r.cases)); });
    return list_[list_.length - 1] || null;
  }

  function cellOf(status) {
    var label = CELL_LABELS[status] || "unknown";
    return { status: typeof status === "string" ? status : "unknown", label: label };
  }

  // Declared routes for one run, unexercised first. Columns follow the run's
  // configured lanes, so a lane added later shows up without a page change.
  function routeMatrix(run) {
    if (!run || !isObj(run.routes)) return null;
    var lanes = isObj(run.lanes) && list(run.lanes.configured).length > 0 ? list(run.lanes.configured) : LANES;
    var items = list(run.routes.items).filter(isObj);
    var rows = items.filter(function (i) { return i.declared === true; }).map(function (i) {
      var statuses = isObj(i.lane_status) ? i.lane_status : {};
