    if (!c) { empty(host, "Cases not reported for these filters."); return; }
    if (c.rows.length === 0) { empty(host, "No cases in this run."); return; }
    var rows = c.rows.map(function (r) {
      var q = r.quarantine ? r.quarantine.reason + (r.quarantine.until ? " until " + r.quarantine.until : "") : "";
      var qCell = el("span", r.quarantine && r.quarantine.expired ? "flag" : null, q + (r.quarantine && r.quarantine.expired ? " (expired)" : ""));
      return [r.id, r.tags.join(", "), statusCell(r.status, r.status),
        r.attempts === null ? "" : r.attempts + (r.flaky ? " (flaky)" : ""), qCell, r.history, r.source];
    });
    clear(host);
    host.appendChild(table(["Case", "Tags", "Status", "Attempts", "Quarantine", "Last results", "Source"], rows,
      [false, false, false, true, false, false, false]));
  }

  // --- imported groups
  function renderGroups() {
    var g = M.groupsTable(runs, filters);
    var host = byId("groups-table");
    byId("groups-run").textContent = g ? "Run " + g.runId + (g.sha ? " at " + g.sha : "") : "";
    if (!g) { empty(host, "Imported coverage not reported for these filters."); return; }
    if (g.rows.length === 0) { empty(host, "No groups in the latest import."); return; }
    var rows = g.rows.map(function (r) {
      var track = el("div", "bar-track");
      track.setAttribute("aria-hidden", "true");
      var fill = el("div", "bar-fill");
      fill.style.width = (r.line && r.line.pct !== null ? r.line.pct : 0) + "%";
      track.appendChild(fill);
      return [r.name + (r.stale ? " (stale)" : ""), r.label + " (" + r.format + ")", pctText(r.line), track,
        r.line ? r.line.covered + " / " + r.line.total : "not reported",
        r.branch ? pctText(r.branch) + " (" + r.branch.covered + " / " + r.branch.total + ")" : "not reported",
        r.delta === null ? "" : signed(r.delta, " pts") + (r.prevSha ? " vs " + r.prevSha : "")];
    });
    clear(host);
    host.appendChild(table(["Group", "Import", "Line", "", "Lines", "Branches", "Change"], rows,
      [false, false, true, false, true, false, true]));
  }

  // --- history
  function renderHistory() {
    var host = byId("history-table");
    var rows = M.history(model).map(function (r) {
      var pr = "";
      if (r.pr) {
        if (r.pr.url) { pr = el("a", null, "#" + r.pr.number); pr.setAttribute("href", r.pr.url); }
        else pr = "#" + r.pr.number;
      }
      var id = r.note ? el("span", "flag", (r.id ? r.id + ": " : "") + r.note) : r.id;
      return [id, r.recorded_at, r.schema === null ? "" : r.schema, r.toolkit, r.source, r.scope, r.app, r.profile, r.branch, r.sha, pr];
    });
    clear(host);
    if (rows.length === 0) { empty(host, "No runs recorded yet."); return; }
    host.appendChild(table(["Run", "Recorded", "Schema", "Toolkit", "Source", "Scope", "App", "Profile", "Branch", "SHA", "PR"], rows));
  }

  function renderNote() {
    var note = byId("default-note");
    var onFallback = defaults.fallbackBranch !== null && filters.branch === defaults.filters.branch && filters.scope === "all";
    note.textContent = onFallback ? "No full-scope run on the trunk branch yet; showing the latest full-scope run, on branch " + defaults.fallbackBranch + "." : "";
    show(note, onFallback);
  }

  function render() {
    renderNote();
    renderHeadline();
    renderTrend();
    renderRoutes();
    renderCases();
    renderGroups();
    renderHistory();
  }
  render();
})();
</script>
</body>
</html>
